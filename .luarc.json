{
  "$schema": "https://raw.githubusercontent.com/LuaLS/vscode-lua/master/setting/schema.json",
  "runtime.version": "Lua 5.2",
  "runtime.path": ["?.lua"],
  "runtime.builtin": {
    "io": "disable",
    "os": "disable",
    "coroutine": "disable"
  },
  "runtime.plugin": "./fmtk-out/factorio/plugin.lua",
  "workspace.checkThirdParty": false,
  "workspace.library": [
    "./fmtk-out/factorio/library",
    "D:/SteamLibrary/steamapps/common/Factorio/data"
  ],
  "workspace.ignoreDir": [".git", "env"],
  "diagnostics.globals": ["__DebugAdapter", "__Profiler"],
  "diagnostics.disable": ["lowercase-global"],
  "language.fixIndent": false
}
